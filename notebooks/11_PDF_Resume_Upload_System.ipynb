    "def clean_text(text):\n",
    "\n",
    "    text = text.lower()\n",
    "\n",
    "    text = re.sub(\n",
    "        r'http\\S+|www\\S+',\n",
    "        '',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    text = re.sub(\n",
    "        r'\\S+@\\S+',\n",
    "        '',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    text = re.sub(\n",
    "        r'[^a-z\\s]',\n",
    "        ' ',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    text = re.sub(\n",
    "        r'\\s+',\n",
    "        ' ',\n",
    "        text\n",
    "    )\n",
    "\n",
    "    return text.strip()"
   ],
   "metadata": {
