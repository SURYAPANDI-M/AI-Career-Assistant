    "def extract_skills(text):\n",
    "\n",
    "    skills = [\n",
    "        \"python\",\n",
    "        \"sql\",\n",
    "        \"machine learning\",\n",
    "        \"tensorflow\",\n",
    "        \"aws\",\n",
    "        \"docker\",\n",
    "        \"kubernetes\",\n",
    "        \"nlp\",\n",
    "        \"pandas\",\n",
    "        \"numpy\"\n",
    "    ]\n",
    "\n",
    "    found=[]\n",
    "\n",
    "    for skill in skills:\n",
    "\n",
    "        if skill in text:\n",
    "            found.append(skill)\n",
    "\n",
    "    return found"
   ],
   "metadata": {
    "id": "KnLOvJZ0sNKN"
   },
