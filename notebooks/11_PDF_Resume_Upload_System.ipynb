   "source": [
    "def recommend_jobs(resume_text, top_n=5):\n",
    "\n",
    "    resume_vector = job_vectorizer.transform(\n",
    "        [resume_text]\n",
    "    )\n",
    "\n",
    "    scores = cosine_similarity(\n",
    "        resume_vector,\n",
    "        job_vectors\n",
    "    )[0]\n",
    "\n",
    "\n",
    "    indexes = scores.argsort()[::-1][:top_n]\n",
    "\n",
    "\n",
    "    result = jobs.iloc[indexes][\n",
    "        [\"Job_Title\"]\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    result[\"Match\"] = (\n",
    "        scores[indexes] * 100\n",
    "    ).round(2)\n",
    "\n",
    "\n",
    "    return result"
   ],
   "metadata": {
    "id": "RUQVZ5chsIEb"
   },
