"    data_path,\\\\n\\\",\\\"    \\\\\\\"raw/skills.txt\\\\\\\"\\\\n\\\",\\\")\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"with open(skills_file,\\\\\\\"r\\\\\\\") as f:\\\\n\\\",\\\"    skills = [\\\\n\\\",\\\"        x.strip().lower()\\\\n\\\",\\\"        for x in f.readlines()\\\\n\\\",\\\"    ]\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"print(\\\\\\\"Total skills:\\\\\\\", len(skills))\\\\n\\\",\\\"print(skills[:10])\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"w-f8gm1CSluT\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\\\":[\\\"def extract_skills(text):\\\\n\\\",\\\"\\\\n\\\",\\\"    text = text.lower()\\\\n\\\",\\\"\\\\n\\\",\\\"    found = []\\\\n\\\",\\\"\\\\n\\\",\\\"    for skill in skills:\\\\n\\\",\\\"\\\\n\\\",\\\"        if skill in text:\\\\n\\\",\\\"            found.append(skill)\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    return sorted(\\\\n\\\",\\\"        list(set(found))\\\\n\\\",\\\"    )\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"PunQYBNtSoCL\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\\\":[\\\"extract_skills(\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\\"Python\\\\n\\\",\\\"Machine Learning\\\\n\\\",\\\"TensorFlow\\\\n\\\",\\\"SQL\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\\")\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"ebmrXygISqQA\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\\\":[\\\"def calculate_text_similarity(\\\\n\\\",\\\"    resume,\\\\n\\\",\\\"    job_description\\\\n\\\",\\\"):\\\\n\\\",\\\"\\\\n\\\",\\\"    resume_vector = tfidf.transform(\\\\n\\\",\\\"        [resume]\\\\n\\\",\\\"    )\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    job_vector = tfidf.transform(\\\\n\\\",\\\"        [job_description]\\\\n\\\",\\\"    )\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    similarity = cosine_similarity(\\\\n\\\",\\\"        resume_vector,\\\\n\\\",\\\"        job_vector\\\\n\\\",\\\"    )[0][0]\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    return round(\\\\n\\\",\\\"        similarity * 100,\\\\n\\\",\\\"        2\\\\n\\\",\\\"    )\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"zfGVKpHeStqY\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\\\":[\\\"def calculate_skill_match(\\\\n\\\",\\\"    resume,\\\\n\\\",\\\"    job_description\\\\n\\\",\\\"):\\\\n\\\",\\\"\\\\n\\\",\\\"    resume_skills = set(\\\\n\\\",\\\"        extract_skills(resume)\\\\n\\\",\\\"    )\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    job_skills = set(\\\\n\\\",\\\"        extract_skills(job_description)\\\\n\\\",\\\"    )\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    if len(job_skills)==0:\\\\n\\\",\\\"        return 0,[],[]\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    matched = sorted(\\\\n\\\",\\\"        list(\\\\n\\\",\\\"            resume_skills.intersection(\\\\n\\\",\\\"                job_skills\\\\n\\\",\\\"            )\\\\n\\\",\\\"        )\\\\n\\\",\\\"    )\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    missing = sorted(\\\\n\\\",\\\"        list(\\\\n\\\",\\\"            job_skills.difference(\\\\n\\\",\\\"                resume_skills\\\\n\\\",\\\"            )\\\\n\\\",\\\"        )\\\\n\\\",\\\"    )\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    score = (\\\\n\\\",\\\"        len(matched)\\\\n\\\",\\\"        /\\\\n\\\",\\\"        len(job_skills)\\\\n\\\",\\\"    )*100\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"    return (\\\\n\\\",\\\"        round(score,2),\\\\n\\\",\\\"        matched,\\\\n\\\",\\\"        missing\\\\n\\\",\\\"    )\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"MKE7uKBqSvn2\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\\\":[\\\"def score_resume(\\\\n\\\",\\\"    resume,\\\\n\\\",\\\"    job_description\\\\n\\\",\\\"):\\\\n\\\",\\\"\\\\n\\\",\\\"    text_score = calculate_text_similarity(\\\\n\\\",\\\"        resume,\\\\n\\\",\\\"        job_description\\\\n\\\",\\\"    )\\\\n