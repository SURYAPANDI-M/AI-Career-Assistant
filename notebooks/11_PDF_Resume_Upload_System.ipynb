rt scores\\\\n\\\",\\\"    df = df.sort_values(\\\\n\\\",\\\"        by=\\\\\\\"Score\\\\\\\",\\\\n\\\",\\\"        ascending=False\\\\n\\\",\\\"    ).reset_index(drop=True)\\\\n\\\",\\\"\\\\n\\\",\\\"    # Round and convert to display format\\\\n\\\",\\\"    df[\\\\\\\"Score\\\\\\\"] = df[\\\\\\\"Score\\\\\\\"].apply(lambda x: f\\\\\\\"{x:.2f}\\\\\\\")\\\\n\\\",\\\"\\\\n\\\",\\\"    # Add rank\\\\n\\\",\\\"    df.insert(\\\\n\\\",\\\"        0,\\\\n\\\",\\\"        \\\\\\\"Rank\\\\\\\",\\\\n\\\",\\\"        range(1, len(df) + 1)\\\\n\\\",\\\"    )\\\\n\\\",\\\"\\\\n\\\",\\\"    return df\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"GPoBquEfTsdB\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\\\":[\\\"jobs = {\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\\\\"Data Scientist\\\\\\\":\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\\"Python\\\\n\\\",\\\"SQL\\\\n\\\",\\\"Machine Learning\\\\n\\\",\\\"TensorFlow\\\\n\\\",\\\"Statistics\\\\n\\\",\\\"AWS\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\",\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\\\\"ML Engineer\\\\\\\":\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\\"Python\\\\n\\\",\\\"Deep Learning\\\\n\\\",\\\"PyTorch\\\\n\\\",\\\"Docker\\\\n\\\",\\\"Kubernetes\\\\n\\\",\\\"AWS\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\",\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"\\\\\\\"Backend Developer\\\\\\\":\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\\"Java\\\\n\\\",\\\"Spring Boot\\\\n\\\",\\\"API\\\\n\\\",\\\"SQL\\\\n\\\",\\\"Database\\\\n\\\",\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\",\\\"\\\\n\\\",\\\"}\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"eeGZHRIdTuGC\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\\\":[\\\"result = compare_jobs(resume, jobs)\\\\n\\\",\\\"\\\\n\\\",\\\"result.style.hide(axis=\\\\\\\"index\\\\\\\")\\\"],\\\"metadata\\\":{\\\"id\\\":\\\"UPNon6PqTv3r\\\"},\\\"execution_count\\\":null,\\\"outputs\\\":[]},{\\\"cell_type\\\":\\\"code\\\",\\\"source\